# Python 虛擬環境（不要上傳到 GitHub）
.venv/
venv/

# Python 執行時產生的暫存檔
__pycache__/
*.pyc

# 密碼、API 金鑰（絕對不要上傳）
.env

# 作業系統自動產生的垃圾檔
.DS_Store
Thumbs.db

# 檢查腳本產生的範例資料（不需要版控）
serpapi_sample.json

# 查詢結果快取（可以隨時刪除，刪了只是下次要重查）
cache/

# 已確認過的展館座標（每個人的不一樣，不需版控）
venues.json

# 匯率快取（可刪，刪了下次重查）
fx_cache.json

# 你在網頁上調整過的限制值（每個人不同，不需版控）
settings.json
